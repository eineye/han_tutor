{
  "name": "han-tutor",
  "version": "0.1.0",
  "private": true,
  "description": "Korean learning web app for teens abroad - with 2D pronunciation coach, Gemini AI conversation, and K-drama style video lessons",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "typecheck": "tsc -b",
    "test": "node --test \"server/tests/*.test.js\"",
    "build:demo": "tsc -b && VITE_DEMO=1 vite build && node scripts/inline-demo.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
