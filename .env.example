# Google Gemini API key (https://aistudio.google.com/apikey)
# Leave empty to run in demo mode (canned AI responses).
GEMINI_API_KEY=
# Gemini model used for chat / feedback (can also be changed in Admin > Settings)
GEMINI_MODEL=gemini-2.5-flash
# Teacher/admin password (CHANGE THIS before deploying)
ADMIN_PASSWORD=admin1234
# API server port
PORT=8787
